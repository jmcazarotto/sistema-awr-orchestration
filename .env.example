# ── Modos ─────────────────────────────────────────────
# mock = Sharp/SVG local em ~1s, sem custo | openai = gpt-image-2 real
IMAGE_ENGINE_MODE=mock
# mock = classificador/revisor heurísticos | openai = modelos reais
AI_MODE=mock
# openai | jev (TypeSafe AI)
CLASSIFIER_PROVIDER=openai
# Em AI_MODE=mock: probabilidade (0–1) de o Diretor reprovar uma arte (testa o loop de ajuste)
MOCK_REJECT_RATE=0.35

# ── Credenciais ───────────────────────────────────────
OPENAI_API_KEY=
JEV_API_KEY=

# ── Modelos (Stack 2026) ──────────────────────────────
CLASSIFIER_MODEL=gpt-6-luna-decisions
IMAGE_MODEL=gpt-image-2
REVIEW_MODEL=gpt-6-luna-decisions
FEEDBACK_MODEL=gpt-6.1-terra
IMAGE_SIZE=1080x1350

# ── Orquestração ──────────────────────────────────────
MAX_HOPS=5
MAX_DIRECTOR_ATTEMPTS=3
DIRECTOR_TICK_MS=15000
PRODUCTION_TIMEOUT_MS=120000
ACERVO_HEARTBEAT_MS=30000
# true = Monalisa preenche o acervo automaticamente ao subir o servidor
ACERVO_AUTOFILL=true
# Demandas de cliente (Van Gogh) esperam o clique em "Produzir" antes de gerar a imagem
PRODUCAO_MANUAL_VAN_GOGH=true

# ── Servidor ──────────────────────────────────────────
PORT=8787
ACERVO_DIR=./acervo
BRAIN_DIR=./brain
DATA_DIR=./data
